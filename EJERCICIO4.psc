Algoritmo ejercicio4
	//Definir las variables 
	Definir precio, totalApagar Como Real
	Definir cantidad Como Entero
	//pedir al usuario el precio y la cantidad
	Escribir "Ingrese el precio del articulo"
	Leer precio
	Escribir "Ingrese la cantidad que lleva el cliente"
	Leer cantidad
	//calcular el total a pagar 
	totalApagar <- precio * cantidad 
	//Mostrar el resultado el resultado
	Escribir " el monto total a pagar por el comprador es:$", totalApagar
	
FinAlgoritmo
